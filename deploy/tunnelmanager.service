[Unit]
Description=TunnelManager - BackPack tunnel control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tunnelmanager
EnvironmentFile=-/etc/default/tunnelmanager
ExecStart=/opt/tunnelmanager/venv/bin/python -m tunnelmanager --data /var/lib/tunnelmanager serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
