[Unit]
Description=TunnelManager - BackPack tunnel control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tunnelmanager
EnvironmentFile=-/etc/default/tunnelmanager
ExecStart=/opt/tunnelmanager/venv/bin/python -m tunnelmanager --data /var/lib/tunnelmanager serve
Restart=always
RestartSec=3
# The panel shares servers with live tunnels: it must never compete with them.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=400M

[Install]
WantedBy=multi-user.target
